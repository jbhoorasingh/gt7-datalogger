    "Subscribe": {
      "additionalProperties": true,
      "properties": {
        "events": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Event types to receive; omitted = all. `status` and `welcome` are always sent.",
          "title": "Events"
        },
        "frame": {
          "default": "compact",
          "description": "`full` adds `packet`: every parsed field of the latest packet.",
          "enum": [
            "compact",
            "full"
          ],
          "title": "Frame",
          "type": "string"
        },
        "telemetry_hz": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Telemetry frames per second; omitted = the server's GT7_WS_RATE.",
          "title": "Telemetry Hz"
        }
      },
      "title": "Subscribe",
      "type": "object"
    },
